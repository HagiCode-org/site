{
  "name": "site",
  "compatibility_date": "2026-05-04",
  // Direct wrangler deploy should publish the validated gh-pages dist/ snapshot as static web assets.
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
