{
  "name": "hagicode-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm run prepare:i18n && astro dev --host 0.0.0.0 --port ${PORT_WEBSITE:-31264}",
    "start": "pnpm run prepare:i18n && astro dev --host 0.0.0.0",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; export NODE_ENV=\"${NODE_ENV:-production}\"; pnpm run prepare:i18n && pnpm run sync:about-snapshot && astro build && pnpm run seo:audit && pnpm run verify:ga",
    "preview": "astro preview --port ${PORT_WEBSITE:-31264}",
    "astro": "astro",
    "i18n:audit": "hagi18n audit --config hagi18n.yaml",
    "i18n:report": "hagi18n report --config hagi18n.yaml",
    "i18n:doctor": "hagi18n doctor --config hagi18n.yaml",
    "i18n:sync": "hagi18n sync --config hagi18n.yaml --from en-US",
    "i18n:sync:write": "hagi18n sync --config hagi18n.yaml --from en-US --write",
    "i18n:prune": "hagi18n prune --config hagi18n.yaml --from en-US",
    "i18n:prune:write": "hagi18n prune --config hagi18n.yaml --from en-US --write",
    "i18n:generate": "node scripts/generate-i18n-resources.mjs",
    "prepare:i18n": "pnpm run i18n:generate",
    "i18n:check": "pnpm run i18n:audit && pnpm run i18n:doctor && pnpm run prepare:i18n && node scripts/generate-i18n-resources.mjs --check",
    "sync:about-snapshot": "node ./scripts/fetch-about-snapshot.mjs",
    "import:r2-images": "node scripts/import-r2-images.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "verify:ga": "node scripts/verify-ga-build.mjs",
    "typecheck": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; pnpm run prepare:i18n && tsc --noEmit",
    "clean": "rm -rf .astro dist",
    "test": "pnpm run prepare:i18n && vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "generate:image": "node scripts/generate-image.mjs",
    "generate:image:custom": "node scripts/generate-image.mjs",
    "generate:product-images": "node scripts/generate-image.mjs --batch-config scripts/product-images-batch.json",
    "regenerate:product-images": "node scripts/generate-image.mjs --batch-config scripts/product-images-batch.json --force",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/partytown": "^2.1.5",
    "@astrojs/react": "^7.0.0",
    "@hagicode/hagilight": "0.20.0",
    "@hagicode/hagilight-core": "0.20.0",
    "astro": "^7.3.8",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-external-links": "^3.0.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-raw": "^3.0.0",
    "semver": "^7.7.4",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@hagicode/hagi18n": "^0.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitest/ui": "^5.0.5",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.58.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.16.1"
  }
}
