---
import LegacyLocaleRedirectPage from '@/page-templates/LegacyLocaleRedirectPage.astro';
import { getNonDefaultSiteLocales } from '@/i18n/locale-metadata';

export function getStaticPaths() {
  return getNonDefaultSiteLocales()
    .filter((locale) => locale !== 'zh-CN')
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: string };
---

<LegacyLocaleRedirectPage target={`/${locale}/`} destinationName="the localized homepage" />
