---
import LegacyLocaleRedirect from '@/components/LegacyLocaleRedirect.astro';

interface Props {
  target: string;
  destinationName?: string;
  movedCopy?: string;
}

const {
  target,
  destinationName = 'the current English page',
  movedCopy = 'We kept this legacy English alias available so older links can continue to the canonical English route.',
} = Astro.props;
---

<LegacyLocaleRedirect targetPath={target} destinationName={destinationName} movedCopy={movedCopy} />
