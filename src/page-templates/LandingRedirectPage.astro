---
/**
 * "/" 中转页 - 路由解析过程的可视化
 *
 * 访问根路径 "/" 时显示。它不是加载动画，而是把中转本身展示出来：
 * 1. 依次检查 ?lang=、已保存的选择、浏览器语言、默认语言，并显示真实取值与最终采用的一项
 * 2. 用与首页字标相同的「提案 → 执行」语言，把解析出的路由 /<locale>/ 跑出来
 * 3. 十种语言始终以真实链接列出：无脚本、爬虫、想自己选语言的访客都能直接用
 *
 * 编排由 CSS 的 --run-dur 统一驱动，脚本见 src/scripts/landing-route-run.ts。
 */

import { SITE_ORIGIN, getLocalizedPath, joinWithSiteBase } from '@/lib/locale-routing';
import { SITE_LOCALES } from '@/i18n/locale-metadata';
import AnalyticsScripts from '@/components/AnalyticsScripts.astro';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import logoUrl from '@/assets/logo.png?url';

const siteBase = import.meta.env.VITE_SITE_BASE || '';
const canonicalUrl = `${SITE_ORIGIN}${joinWithSiteBase(siteBase, '/')}`;
const localeLinks = SITE_LOCALES.map((locale) => ({
  code: locale.code,
  nativeName: locale.nativeName,
  href: joinWithSiteBase(siteBase, getLocalizedPath('/', locale.code)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Hagicode - Smart · Efficient · Fun AI Coding Assistant</title>
    <meta name="description" content="Hagicode helps developers focus on code, not repetitive work. AI-powered coding with OpenSpec workflows and multi-agent execution." />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="og:title" content="Hagicode - AI Coding Assistant" />
    <meta name="og:description" content="Redefine coding with AI. OpenSpec workflows, multi-agent execution, and Scenario-driven gameplay." />
    <meta name="og:type" content="website" />
    <meta name="og:url" content={canonicalUrl} />
    <meta name="robots" content="index,follow" />
    <meta name="hagicode-site-base" content={siteBase} />
    <meta name="hagicode-site-landing-target" content="/" />
    <GoogleAnalytics />
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('starlight-theme'); } catch (_) {}
        var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored || system);
        document.documentElement.classList.add('js');
      })();
    </script>
    <script>
      import { mountLandingRouteRun } from '@/scripts/landing-route-run';
      mountLandingRouteRun();
    </script>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #030712;
        --ink: #f8fafc;
        --muted: #94a3b8;
        --line: rgba(255, 255, 255, 0.12);
        --line-strong: rgba(255, 255, 255, 0.28);
        --accent: #00cccc;
        --accent-ink: #031316;
        --beam-a: #0080ff;
        --beam-b: #00cccc;
        --beam-c: #22c55e;
        --font-sans: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "WenQuanYi Micro Hei", "Segoe UI", system-ui, sans-serif;
        --font-mono: "SF Mono", Menlo, "Cascadia Code", Consolas, "Roboto Mono", "JetBrains Mono", monospace;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      }

      :root[data-theme='light'] {
        color-scheme: light;
        --bg: #f5f5f7;
        --ink: #0f172a;
        --muted: #475569;
        --line: rgba(0, 0, 0, 0.12);
        --line-strong: rgba(0, 0, 0, 0.3);
        --accent: #0060cc;
        --accent-ink: #ffffff;
      }

      /* 提案 → 执行：--run (0 → 1) 同时驱动轮廓、实心字、光束，三层不会错位 */
      @property --run {
        syntax: '<number>';
        inherits: true;
        initial-value: 1;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scrollbar-color: var(--line-strong) transparent;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 1rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      ::selection {
        background: color-mix(in srgb, var(--accent) 34%, transparent);
        color: inherit;
      }

      a {
        color: inherit;
      }

      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ── 页面骨架 ── */
      .page {
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: clamp(1.5rem, 5vh, 3rem);
        width: min(100%, 78rem);
        min-height: 100dvh;
        margin-inline: auto;
        padding: clamp(1.25rem, 4vw, 3rem);
        transition: opacity 180ms cubic-bezier(0.4, 0, 1, 1);
      }

      html[data-state='leaving'] .page {
        opacity: 0;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 1.0625rem;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .brand img {
        width: 28px;
        height: 28px;
        border-radius: 6px;
      }

      .stage {
        display: grid;
        align-self: center;
        gap: clamp(2rem, 5vh, 3.5rem);
      }

      @media (min-width: 64rem) {
        .stage {
          grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
          column-gap: clamp(3rem, 6vw, 6rem);
          align-items: end;
        }

        .locales {
          grid-column: 1 / -1;
        }
      }

      /* 脚本接管的区域：就绪前先隐藏，避免 "—" 与英文占位闪一下；脚本失败时 2.4s 后兜底显示 */
      .js:not([data-ready]) .live {
        opacity: 0;
        animation: liveFailsafe 0s linear 2.4s forwards;
      }

      /* 没有脚本就没有可展示的解析过程；语言链接仍然完整可用 */
      html:not(.js) .trace {
        display: none;
      }

      @keyframes liveFailsafe {
        to {
          opacity: 1;
        }
      }

      /* ── 路由字标 ── */
      .route {
        margin: 0 0 0.12em;
        font-size: clamp(2.75rem, 7.2vw, 6rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.03em;
        white-space: nowrap;
      }

      .route-origin {
        color: var(--ink);
      }

      .route-target {
        display: inline-block;
      }

      .run {
        --run: 1;
        --edge: 0.1em;
        position: relative;
        display: inline-grid;
        vertical-align: top;
        padding-bottom: 0.12em;
      }

      html[data-ready]:not([data-pace='still']) .run {
        animation: routeRun var(--run-dur, 1250ms) cubic-bezier(0.3, 0.55, 0.15, 1) both;
      }

      @keyframes routeRun {
        from {
          --run: 0;
        }
        to {
          --run: 1;
        }
      }

      .run-ghost,
      .run-solid {
        grid-area: 1 / 1;
        display: block;
        white-space: nowrap;
      }

      .run-solid {
        color: var(--accent);
        clip-path: inset(-0.3em calc((1 - var(--run)) * 100% - var(--run) * var(--edge)) -0.3em -0.3em);
      }

      /* 尚未执行的字形：只有轮廓，光束走过后消失 */
      .run-ghost {
        color: transparent;
        user-select: none;
        -webkit-text-stroke: max(1.5px, 0.012em) color-mix(in srgb, var(--accent) 82%, transparent);
        clip-path: inset(-0.3em -0.3em -0.3em calc(var(--run) * (100% + var(--edge))));
        opacity: min(1, calc((1 - var(--run)) * 10));
      }

      .run-beam {
        position: absolute;
        top: -0.04em;
        bottom: 0.1em;
        left: calc(var(--run) * (100% + var(--edge)));
        width: max(2px, 0.02em);
        margin-left: calc(max(2px, 0.02em) / -2);
        background: linear-gradient(180deg, var(--beam-a), var(--beam-b) 52%, var(--beam-c));
        opacity: min(1, calc(var(--run) * 14), calc((1 - var(--run)) * 14));
        pointer-events: none;
      }

      /* 光束尾迹：刚刚执行过的地方 */
      .run-beam::before {
        content: '';
        position: absolute;
        inset: 0 100% 0 auto;
        width: 0.7em;
        background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--beam-b) 24%, transparent));
        mask-image: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
        -webkit-mask-image: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
      }

      /* ── 标题与状态 ── */
      .headline {
        margin: 1rem 0 0;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.2;
        text-wrap: balance;
      }

      .status {
        max-width: 38ch;
        /* 两行的高度：提示与「已停止」文案互换时，整个版面不跳动 */
        min-height: 3em;
        margin: 0.75rem 0 0;
        color: var(--muted);
        font-size: 0.9375rem;
        line-height: 1.5;
        text-wrap: pretty;
      }

      html[data-state='paused'] .status {
        color: var(--ink);
      }

      /* ── 解析过程：每一行都是真实输入 ── */
      .trace {
        margin: 0;
        border-bottom: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.4;
      }

      .trace-row {
        display: grid;
        grid-template-areas: 'label verdict' 'value value';
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.125rem 1rem;
        padding: 0.75rem 0;
        border-top: 1px solid var(--line);
        color: var(--muted);
      }

      @media (min-width: 40rem) {
        .trace-row {
          grid-template-areas: 'label value verdict';
          grid-template-columns: minmax(0, 11.5rem) minmax(0, 1fr) 4.5rem;
          gap: 0 1rem;
          align-items: baseline;
        }
      }

      .trace-row dt {
        grid-area: label;
        overflow-wrap: anywhere;
      }

      .trace-value {
        grid-area: value;
        margin: 0;
        overflow-wrap: anywhere;
      }

      .trace-verdict {
        grid-area: verdict;
        margin: 0;
        font-family: var(--font-sans);
        font-size: 0.8125rem;
        font-weight: 600;
        text-align: right;
        white-space: nowrap;
      }

      .trace-verdict:empty {
        display: none;
      }

      .trace-row[data-state='used'] {
        color: var(--ink);
      }

      .trace-row[data-state='used'] .trace-value {
        color: var(--accent);
        font-weight: 600;
      }

      .trace-row[data-state='used'] .trace-verdict {
        color: var(--accent);
      }

      .trace-row[data-state='used'] .trace-verdict::before {
        content: '';
        display: inline-block;
        width: 0.4375rem;
        height: 0.4375rem;
        margin-right: 0.4375rem;
        border-radius: 50%;
        background: var(--accent);
      }

      html[data-ready]:not([data-pace='still']) .trace-row {
        animation: traceIn 520ms var(--ease-out) both;
        animation-delay: calc(var(--run-dur, 1250ms) * 0.12 * var(--i, 0));
      }

      html[data-ready]:not([data-pace='still']) .trace-row[data-state='used'] .trace-verdict {
        animation: verdictIn 360ms var(--ease-out) both;
        animation-delay: calc(var(--run-dur, 1250ms) * 0.78);
      }

      @keyframes traceIn {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
      }

      @keyframes verdictIn {
        from {
          opacity: 0;
          transform: translateX(-6px);
        }
      }

      /* ── 语言列表：真实链接，也是手动选择入口 ── */
      .locales-label {
        margin: 0 0 0.75rem;
        color: var(--muted);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .locales ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .locales a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 1rem;
        border: 1px solid var(--line-strong);
        border-radius: 9999px;
        background: linear-gradient(var(--accent), var(--accent)) no-repeat left / 0% 100%;
        font-size: 0.9375rem;
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: 0.01em;
        text-decoration: none;
        transition:
          border-color 150ms ease,
          transform 150ms ease;
      }

      .locales a:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
      }

      .locales a[aria-current='true'] {
        border-color: var(--accent);
        color: var(--accent-ink);
        background-size: 100% 100%;
      }

      /* 选中的语言在光束走完时被填满：同一次执行的落点 */
      html[data-ready]:not([data-pace='still']) .locales a[aria-current='true'] {
        animation: chipFill 420ms var(--ease-out) both;
        animation-delay: calc(var(--run-dur, 1250ms) * 0.92);
      }

      @keyframes chipFill {
        from {
          background-size: 0% 100%;
          color: var(--accent);
        }
        to {
          background-size: 100% 100%;
          color: var(--accent-ink);
        }
      }

      /* ── 页脚 ── */
      .quick-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.5rem;
        font-size: 0.8125rem;
      }

      .quick-links a {
        padding: 0.5rem 0;
        color: var(--muted);
        text-underline-offset: 0.2em;
        text-decoration-color: transparent;
        transition: color 150ms ease, text-decoration-color 150ms ease;
      }

      .quick-links a:hover {
        color: var(--ink);
        text-decoration-color: currentColor;
      }

      @media (prefers-reduced-motion: reduce) {
        .locales a:hover {
          transform: none;
        }
      }

      @media (forced-colors: active) {
        .locales a[aria-current='true'] {
          outline: 2px solid Highlight;
          forced-color-adjust: none;
          color: HighlightText;
          background: Highlight;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <span class="brand">
          <img src={logoUrl} width="28" height="28" alt="" />
          HagiCode
        </span>
      </header>

      <main class="stage">
        <div class="intro">
          <p class="route" aria-hidden="true"><span class="route-origin">/</span><span id="landing-route-target" class="route-target live"></span></p>
          <h1 id="landing-heading" class="headline">Choose a language to open HagiCode</h1>
          <p id="landing-status" class="status live" role="status">Select a language to continue.</p>
        </div>

        <dl class="trace live">
          <div class="trace-row" data-trace="query">
            <dt>?lang=</dt>
            <dd class="trace-value" data-trace-value>—</dd>
            <dd class="trace-verdict" data-trace-verdict></dd>
          </div>
          <div class="trace-row" data-trace="stored">
            <dt>hagicode:site-locale</dt>
            <dd class="trace-value" data-trace-value>—</dd>
            <dd class="trace-verdict" data-trace-verdict></dd>
          </div>
          <div class="trace-row" data-trace="browser">
            <dt>navigator.languages</dt>
            <dd class="trace-value" data-trace-value>—</dd>
            <dd class="trace-verdict" data-trace-verdict></dd>
          </div>
          <div class="trace-row" data-trace="default">
            <dt>default</dt>
            <dd class="trace-value" data-trace-value>en-US</dd>
            <dd class="trace-verdict" data-trace-verdict></dd>
          </div>
        </dl>

        <nav class="locales" aria-labelledby="landing-language-label" data-locale-list>
          <p id="landing-language-label" class="locales-label">Language</p>
          <ul>
            {localeLinks.map((locale) => (
              <li>
                <a href={locale.href} lang={locale.code} data-locale={locale.code}>{locale.nativeName}</a>
              </li>
            ))}
          </ul>
        </nav>
      </main>

      <footer>
        <nav class="quick-links" aria-label="Quick links">
          <a href="/en-US/docs/">Docs</a>
          <a href="https://github.com/hagicode" target="_blank" rel="noopener">GitHub</a>
          <a href="/en-US/about/">About</a>
        </nav>
      </footer>
    </div>

    <AnalyticsScripts />
  </body>
</html>
