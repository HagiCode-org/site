---
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import MicrosoftStoreBadgeScript from '@/components/MicrosoftStoreBadgeScript.astro';
import Footer from '@/components/home/Footer';
import Navbar from '@/components/home/Navbar';
import SeoAlternateLinks from '@/components/SeoAlternateLinks.astro';
import type { SiteLocale } from '@/i18n/locale-metadata';
import { getHomepageInteractiveCopy } from '@/lib/homepage-runtime-copy';
import { getAbsoluteSiteUrl } from '@/lib/locale-routing';
import { getClaudeVsHagicodePageModel } from '@/lib/claude-vs-hagicode-copy';
import '@/styles/homepage.css';
import '@/components/compare/compare-page.css';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const siteBase = import.meta.env.VITE_SITE_BASE || '';
const interactiveCopy = getHomepageInteractiveCopy(locale);
const pageModel = getClaudeVsHagicodePageModel(locale);
const canonicalUrl = getAbsoluteSiteUrl('/claude-vs-hagicode/', locale, siteBase);
---

<!doctype html>
<html lang={locale} data-site-base={siteBase}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageModel.seo.title}</title>
    <meta name="description" content={pageModel.seo.description} />
    <link rel="canonical" href={canonicalUrl} />
    <SeoAlternateLinks pathname="/claude-vs-hagicode/" siteBase={siteBase} currentLocale={locale} />
    <meta name="baidu-site-verification" content="codeva-A9s3yT3z5m" />
    <meta name="og:title" content={pageModel.seo.title} />
    <meta name="og:description" content={pageModel.seo.description} />
    <meta name="og:type" content="website" />
    <meta name="og:url" content={canonicalUrl} />
    <GoogleAnalytics />
    <MicrosoftStoreBadgeScript />
    <script is:inline>
      (function() {
        function isLunarNewYearPeriod() {
          const now = new Date();
          const year = now.getFullYear();
          const month = now.getMonth() + 1;
          const day = now.getDate();
          if (year === 2025) {
            if (month === 1 && day >= 29) return true;
            if (month === 2 && day <= 12) return true;
          }
          if (year === 2026) {
            if (month === 2 && day >= 17) return true;
            if (month === 3 && day <= 3) return true;
          }
          return false;
        }

        const stored = localStorage.getItem('starlight-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = stored || (isLunarNewYearPeriod() ? 'lunar-new-year' : system);
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="homepage">
    <Navbar
      client:idle
      locale={locale}
      copy={interactiveCopy.navbar}
      themeToggleCopy={interactiveCopy.themeToggle}
      languageSwitcherCopy={interactiveCopy.languageSwitcher}
    />
    <main class="compare-page">
      <!-- Hero -->
      <section class="compare-page__hero">
        <span class="compare-page__badge">{pageModel.ui.badge}</span>
        <h1 class="compare-page__title">{pageModel.ui.pageTitle}</h1>
        <p class="compare-page__subtitle">{pageModel.ui.subtitle}</p>
      </section>

      <div class="compare-page__body">
        <!-- Back link -->
        <a href="/docs/faq/claude-vs-hagicode/" class="compare-page__back" rel="noopener">
          {pageModel.ui.backLink}
        </a>

        <!-- Intro -->
        <section class="compare-section">
          <h2 class="compare-section__title">{pageModel.intro.title}</h2>
          <p class="compare-section__lead">{pageModel.intro.lead}</p>
        </section>

        <!-- Claude Capabilities -->
        <section class="compare-section">
          <h2 class="compare-section__title">{pageModel.claudeCapabilities.sectionTitle}</h2>

          {
            pageModel.claudeCapabilities.features.map((feature) => (
              <div class="compare-feature-card">
                <h3 class="compare-feature-card__title">{feature.title}</h3>
                {feature.paragraphs.map((p) => <p class="compare-feature-card__text">{p}</p>)}
              </div>
            ))
          }

          <div class="compare-subsection">
            <h3 class="compare-subsection__title">{pageModel.claudeCapabilities.modelTitle}</h3>
            {pageModel.claudeCapabilities.modelParagraphs.map((p) => <p class="compare-subsection__text">{p}</p>)}
          </div>

          <div class="compare-subsection">
            <h3 class="compare-subsection__title">{pageModel.claudeCapabilities.ecosystemTitle}</h3>
            {pageModel.claudeCapabilities.ecosystemParagraphs.map((p) => <p class="compare-subsection__text">{p}</p>)}
          </div>
        </section>

        <!-- HagiCode Advantages -->
        <section class="compare-section">
          <h2 class="compare-section__title">{pageModel.hagiCodeAdvantages.sectionTitle}</h2>

          {
            pageModel.hagiCodeAdvantages.advantages.map((adv, idx) => (
              <div class="compare-advantage-card">
                <div class="compare-advantage-card__header">
                  <span class="compare-advantage-card__number">{String(idx + 1).padStart(2, '0')}</span>
                  <h3 class="compare-advantage-card__title">{adv.title}</h3>
                </div>
                <p class="compare-advantage-card__summary">{adv.summary}</p>
                <ul class="compare-advantage-card__details">
                  {adv.details.map((d) => <li class="compare-advantage-card__detail">{d}</li>)}
                </ul>
              </div>
            ))
          }
        </section>

        <!-- Summary -->
        <section class="compare-section">
          <h2 class="compare-section__title">{pageModel.summary.sectionTitle}</h2>

          <div class="compare-summary">
            {pageModel.summary.paragraphs.map((p) => <p class="compare-summary__text">{p}</p>)}

            <ul class="compare-summary__bullets">
              {
                pageModel.summary.bullets.map((b, idx) => (
                  <li class="compare-summary__bullet">
                    <span class="compare-summary__bullet-icon">
                      {['🧠', '⚡', '🗺️', '🎯'][idx] ?? '▸'}
                    </span>
                    <span>{b}</span>
                  </li>
                ))
              }
            </ul>

            <p class="compare-summary__closing">{pageModel.summary.closing}</p>
          </div>
        </section>

        <!-- CTA -->
        <div class="compare-cta">
          <p class="compare-cta__text">
            准备好把 Claude 的实力完全发挥出来了吗？
          </p>
          <a href="/" class="compare-cta__button">
            了解 HagiCode
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
