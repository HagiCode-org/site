---
import Navbar from '@/components/home/Navbar';
import HeroSection from '@/components/home/HeroSection';
import WorkflowStepsSection from '@/components/home/WorkflowStepsSection.astro';
import FeaturesShowcase from '@/components/home/FeaturesShowcase';
import ShowcaseSection from '@/components/home/ShowcaseSection';
import VideoShowcase from '@/components/home/VideoShowcase';
import CompareArena from '@/components/compare/CompareArena.astro';
import PricingComparisonSection from '@/components/home/PricingComparisonSection';
import PromotoBanner from '@hagicode/hagilight-core/PromotoBanner';
import SiteFooter from '@/components/SiteFooter.astro';
import LunarNewYearDecorations from '@/components/home/LunarNewYearDecorations';
import AnalyticsScripts from '@/components/AnalyticsScripts.astro';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import MicrosoftStoreBadgeScript from '@/components/MicrosoftStoreBadgeScript.astro';
import SeoAlternateLinks from '@/components/SeoAlternateLinks.astro';
import showcaseProposalWorkflow from '../assets/img/home/showcase-proposal-workflow.png';
import showcaseSessionBoard from '../assets/img/home/showcase-session-board.png';
import showcaseTokenAnalytics from '../assets/img/home/showcase-token-analytics.png';
import showcaseWorkspaceManagement from '../assets/img/home/showcase-workspace-management.png';
import showcaseAchievementProgress from '../assets/img/home/showcase-achievement-progress.png';
import personaStrategistAvatar from '../assets/r2/hero-avatars/cat-abstract-08.avif';
import personaRunnerAvatar from '../assets/r2/hero-avatars/cat-line-11.avif';
import personaArtistAvatar from '../assets/r2/hero-avatars/cat-oil-08.avif';
import r2Manifest from '../../r2-images.manifest.json';
import { getImage } from 'astro:assets';
import '@/styles/homepage.css';

import type { ImageMetadata } from 'astro';
import type { SiteLocale } from '@/i18n/locale-metadata';
import { getAbsoluteSiteUrl } from '@/lib/locale-routing';
import {
  getHomepageFeaturesCopy,
  getHomepageShowcaseCopy,
  getHomepageWorkflowStepsCopy,
  getPricingContent,
} from '@/lib/homepage-section-copy';
import { getHomepageCliProfiles } from '@/lib/structured-articles.mjs';
import { getHomepageInteractiveCopy } from '@/lib/homepage-runtime-copy';
import { getHomePageCopy } from '@/lib/site-page-copy';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const siteBase = import.meta.env.VITE_SITE_BASE || '';
const pageCopy = getHomePageCopy(locale);
const interactiveCopy = getHomepageInteractiveCopy(locale);
const featuresCopy = getHomepageFeaturesCopy(locale);
const cliProfiles = getHomepageCliProfiles(locale);
const showcaseCopy = getHomepageShowcaseCopy(locale);
const workflowStepsCopy = getHomepageWorkflowStepsCopy(locale);
const pricingContent = getPricingContent(locale);
const canonicalUrl = getAbsoluteSiteUrl('/', locale, siteBase);

async function getShowcaseImageSources(source: ImageMetadata) {
  const [avif, webp] = await Promise.all([
    getImage({ src: source, format: 'avif' }),
    getImage({ src: source, format: 'webp' }),
  ]);
  return { avif: avif.src, webp: webp.src, src: source.src };
}

const showcaseImages = {
  proposalWorkflow: await getShowcaseImageSources(showcaseProposalWorkflow),
  sessionBoard: await getShowcaseImageSources(showcaseSessionBoard),
  tokenAnalytics: await getShowcaseImageSources(showcaseTokenAnalytics),
  workspaceManagement: await getShowcaseImageSources(showcaseWorkspaceManagement),
  achievementProgress: await getShowcaseImageSources(showcaseAchievementProgress),
};

async function getPersonaAvatarSources(source: ImageMetadata) {
  const [avif, webp] = await Promise.all([
    getImage({ src: source, format: 'avif', width: 112, height: 112 }),
    getImage({ src: source, format: 'webp', width: 112, height: 112 }),
  ]);
  return { avif: avif.src, webp: webp.src, src: webp.src };
}

// Persona defaults are vendored R2 images (r2-images.manifest.json); the pool is the R2 list a persona may swap to.
const r2PersonaPool = r2Manifest.pools['features-persona-avatar'].entries.map(
  (entry) => `${r2Manifest.base}/${entry.objectKey}`,
);
const personaAvatars = {
  strategist: await getPersonaAvatarSources(personaStrategistAvatar),
  runner: await getPersonaAvatarSources(personaRunnerAvatar),
  artist: await getPersonaAvatarSources(personaArtistAvatar),
};
---

<!doctype html>
<html lang={locale} data-site-base={siteBase}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageCopy.title}</title>
    <meta name="description" content={pageCopy.description} />
    <link rel="canonical" href={canonicalUrl} />
    <SeoAlternateLinks pathname="/" siteBase={siteBase} currentLocale={locale} />
    <meta name="baidu-site-verification" content="codeva-A9s3yT3z5m" />
    <meta name="og:title" content={pageCopy.title} />
    <meta name="og:description" content={pageCopy.description} />
    <meta name="og:type" content="website" />
    <GoogleAnalytics />
    <MicrosoftStoreBadgeScript />
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
      (function() {
        function isLunarNewYearPeriod() {
          const now = new Date();
          const year = now.getFullYear();
          const month = now.getMonth() + 1;
          const day = now.getDate();
          if (year === 2025) {
            if (month === 1 && day >= 29) return true;
            if (month === 2 && day <= 12) return true;
          }
          if (year === 2026) {
            if (month === 2 && day >= 17) return true;
            if (month === 3 && day <= 3) return true;
          }
          return false;
        }

        const stored = localStorage.getItem('starlight-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = stored || (isLunarNewYearPeriod() ? 'lunar-new-year' : system);
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="homepage">
    <LunarNewYearDecorations client:idle />
    <Navbar
      client:idle
      locale={locale}
      copy={interactiveCopy.navbar}
      themeToggleCopy={interactiveCopy.themeToggle}
      languageSwitcherCopy={interactiveCopy.languageSwitcher}
    />

    <main class="homepage" id="homepage-content" data-homepage-locale={locale}>
      <HeroSection
        client:idle
        locale={locale}
        copy={interactiveCopy.hero}
        workflowBoardCopy={interactiveCopy.workflowBoard}
        productOverviewVideo={{
          copy: pageCopy.productOverviewVideoCopy,
          featuredVideos: pageCopy.featuredHomepageVideos,
        }}
      />
      <CompareArena locale={locale} />
      <WorkflowStepsSection copy={workflowStepsCopy} />
      <FeaturesShowcase
        copy={featuresCopy}
        cliProfiles={cliProfiles}
        personaAvatars={personaAvatars}
        personaPool={r2PersonaPool}
        client:visible
      />
      <ShowcaseSection copy={showcaseCopy} images={showcaseImages} client:visible />
      <VideoShowcase
        eyebrow={pageCopy.supportingSection.eyebrow}
        title={pageCopy.supportingSection.title}
        description={pageCopy.supportingSection.description}
        supportingLabel={pageCopy.supportingSection.supportingLabel}
        supportingVideos={pageCopy.supportingHomepageVideos}
      />
      <PricingComparisonSection
        content={pricingContent}
      />
    </main>

    <PromotoBanner locale={locale} />
    <SiteFooter locale={locale} />
    <AnalyticsScripts />
  </body>
</html>
