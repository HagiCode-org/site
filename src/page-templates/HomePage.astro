---
import Navbar from '@/components/home/Navbar';
import HeroSection from '@/components/home/HeroSection';
import WorkflowStepsSection from '@/components/home/WorkflowStepsSection.astro';
import FeaturesShowcase from '@/components/home/FeaturesShowcase';
import ShowcaseSection from '@/components/home/ShowcaseSection';
import VideoShowcase from '@/components/home/VideoShowcase';
import CompareArena from '@/components/compare/CompareArena.astro';
import PricingComparisonSection from '@/components/home/PricingComparisonSection';
import PromotoBanner from '@hagicode/hagilight-core/PromotoBanner';
import SiteFooter from '@/components/SiteFooter.astro';
import LunarNewYearDecorations from '@/components/home/LunarNewYearDecorations';
import AnalyticsScripts from '@/components/AnalyticsScripts.astro';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import MicrosoftStoreBadgeScript from '@/components/MicrosoftStoreBadgeScript.astro';
import SeoAlternateLinks from '@/components/SeoAlternateLinks.astro';
import showcaseSessionBoard from '../assets/img/home/showcase-session-board.png';
import showcaseProposalWorkflow from '../assets/img/home/showcase-proposal-workflow.png';
import showcaseAgentRoster from '../assets/img/home/showcase-agent-roster.png';
import showcaseAgentCli from '../assets/img/home/showcase-agent-cli.png';
import showcaseSkillsGallery from '../assets/img/home/showcase-skills-gallery.png';
import showcaseVault from '../assets/img/home/showcase-vault.png';
import showcaseTokenUsage from '../assets/img/home/showcase-token-usage.png';
import showcaseAchievements from '../assets/img/home/showcase-achievements.png';
import showcaseGitManagement from '../assets/img/home/showcase-git-management.png';
import showcaseScheduledPlans from '../assets/img/home/showcase-scheduled-plans.png';
import personaStrategistAvatar from '../assets/r2/cat-head-gallery/g017-cyanotype-06-256.avif';
import personaRunnerAvatar from '../assets/r2/cat-head-gallery/g004-pixel-art-03-256.avif';
import personaArtistAvatar from '../assets/r2/cat-head-gallery/g045-impressionist-08-256.avif';
import funWorldAgentsCover from '../assets/r2/cat-head-gallery/g002-ukiyo-e-01-960.avif';
import funHeroFrame01 from '../assets/r2/claude-antler-girl-gallery/g47-knitted-wool-19-256.avif';
import funHeroFrame02 from '../assets/r2/deepseek-whale-girl-gallery/g10-felt-plush-14-256.avif';
import funHeroFrame03 from '../assets/r2/doubao-sunny-girl-gallery/g48-chunky-flat-cartoon-02-256.avif';
import funHeroFrame04 from '../assets/r2/gemini-twin-star-girl-gallery/g32-semi-3d-anime-07-256.avif';
import funHeroFrame05 from '../assets/r2/glm-black-book-girl-gallery/g44-pastel-chalk-06-256.avif';
import funHeroFrame06 from '../assets/r2/gpt-knot-girl-gallery/g32-semi-3d-anime-07-256.avif';
import funHeroFrame07 from '../assets/r2/grok-punk-girl-gallery/g35-semi-3d-anime-16-256.avif';
import funHeroFrame08 from '../assets/r2/hunyuan-neon-girl-gallery/g11-vinyl-toy-14-256.avif';
import funHeroFrame09 from '../assets/r2/kimi-moon-girl-gallery/g45-moonlit-ink-wash-18-256.avif';
import funHeroFrame10 from '../assets/r2/minimax-conch-girl-gallery/g46-pearl-hologram-03-256.avif';
import funHeroFrame11 from '../assets/r2/qwen-porcelain-girl-gallery/g32-semi-3d-anime-07-256.avif';
import funHeroFrame12 from '../assets/r2/claude-antler-girl-gallery/g03-paper-cut-layers-09-256.avif';
import funHeroFrame13 from '../assets/r2/deepseek-whale-girl-gallery/g12-origami-04-256.avif';
import funHeroFrame14 from '../assets/r2/doubao-sunny-girl-gallery/g47-toy-block-figure-17-256.avif';
import funHeroFrame15 from '../assets/r2/gemini-twin-star-girl-gallery/g17-painterly-anime-scenery-08-256.avif';
import funHeroFrame16 from '../assets/r2/glm-black-book-girl-gallery/g10-felt-plush-11-256.avif';
import funHeroFrame17 from '../assets/r2/gpt-knot-girl-gallery/g27-picture-book-08-256.avif';
import funHeroFrame18 from '../assets/r2/grok-punk-girl-gallery/g18-90s-anime-cel-02-256.avif';
import funHeroFrame19 from '../assets/r2/hunyuan-neon-girl-gallery/g44-pastel-chalk-14-256.avif';
import funHeroFrame20 from '../assets/r2/kimi-moon-girl-gallery/g49-paper-lantern-glow-20-256.avif';
import funHeroFrame21 from '../assets/r2/minimax-conch-girl-gallery/g05-flat-vector-sticker-12-256.avif';
import funHeroFrame22 from '../assets/r2/qwen-porcelain-girl-gallery/g21-modern-anime-16-256.avif';
import r2Manifest from '../../r2-images.manifest.json';
import { getImage } from 'astro:assets';
import '@/styles/homepage.css';

import type { ImageMetadata } from 'astro';
import type { SiteLocale } from '@/i18n/locale-metadata';
import { getAbsoluteSiteUrl } from '@/lib/locale-routing';
import {
  getHomepageFeaturesCopy,
  getHomepageShowcaseCopy,
  getHomepageWorkflowStepsCopy,
  getPricingContent,
} from '@/lib/homepage-section-copy';
import { getHomepageCliProfiles } from '@/lib/structured-articles.mjs';
import { getHomepageInteractiveCopy } from '@/lib/homepage-runtime-copy';
import { getHomePageCopy } from '@/lib/site-page-copy';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const siteBase = import.meta.env.VITE_SITE_BASE || '';
const pageCopy = getHomePageCopy(locale);
const interactiveCopy = getHomepageInteractiveCopy(locale);
const featuresCopy = getHomepageFeaturesCopy(locale);
const cliProfiles = getHomepageCliProfiles(locale);
const showcaseCopy = getHomepageShowcaseCopy(locale);
const workflowStepsCopy = getHomepageWorkflowStepsCopy(locale);
const pricingContent = getPricingContent(locale);
const canonicalUrl = getAbsoluteSiteUrl('/', locale, siteBase);

/** Stage and lightbox take a responsive set up to the capture's own width; the filmstrip takes one 480 px rendition. */
const SHOWCASE_WIDTHS = [960, 1600, 2400];

async function getShowcaseImageSources(source: ImageMetadata) {
  const widths = SHOWCASE_WIDTHS.filter((width) => width < source.width).concat(source.width);
  const [avif, webp, thumbAvif, thumbWebp] = await Promise.all([
    getImage({ src: source, format: 'avif', widths }),
    getImage({ src: source, format: 'webp', widths }),
    getImage({ src: source, format: 'avif', width: 480 }),
    getImage({ src: source, format: 'webp', width: 480 }),
  ]);
  return {
    avif: avif.srcSet.attribute,
    webp: webp.srcSet.attribute,
    src: source.src,
    width: source.width,
    height: source.height,
    thumb: { avif: thumbAvif.src, webp: thumbWebp.src, src: thumbWebp.src },
  };
}

const showcaseImages = {
  sessionBoard: await getShowcaseImageSources(showcaseSessionBoard),
  proposalWorkflow: await getShowcaseImageSources(showcaseProposalWorkflow),
  agentRoster: await getShowcaseImageSources(showcaseAgentRoster),
  agentCli: await getShowcaseImageSources(showcaseAgentCli),
  skillsGallery: await getShowcaseImageSources(showcaseSkillsGallery),
  vault: await getShowcaseImageSources(showcaseVault),
  tokenUsage: await getShowcaseImageSources(showcaseTokenUsage),
  achievements: await getShowcaseImageSources(showcaseAchievements),
  gitManagement: await getShowcaseImageSources(showcaseGitManagement),
  scheduledPlans: await getShowcaseImageSources(showcaseScheduledPlans),
};

async function getR2ImageSources(source: ImageMetadata, width: number, height: number) {
  const [avif, webp] = await Promise.all([
    getImage({ src: source, format: 'avif', width, height }),
    getImage({ src: source, format: 'webp', width, height }),
  ]);
  return { avif: avif.src, webp: webp.src, src: webp.src };
}

// Persona defaults are vendored R2 images (r2-images.manifest.json); the pool is the R2 list a persona may swap to.
const r2PersonaPool = r2Manifest.pools['features-persona-avatar'].entries.map(
  (entry) => `${r2Manifest.base}/${entry.objectKey}`,
);
const personaAvatars = {
  strategist: await getR2ImageSources(personaStrategistAvatar, 112, 112),
  runner: await getR2ImageSources(personaRunnerAvatar, 112, 112),
  artist: await getR2ImageSources(personaArtistAvatar, 112, 112),
};

// Fun-section frames: the first world cover (a cat head from cat-head-gallery) and the hero strip (two heads from
// each AI model's character gallery) are vendored renditions; the other world covers are rotating remote frames (see the manifest).
const funWorldCovers = {
  agents: await getR2ImageSources(funWorldAgentsCover, 720, 480),
};
// Rotating remote frames: the other covers, referenced by their object URL and requested only on activation.
const funRemoteWorldCovers = Object.fromEntries(
  r2Manifest.entries
    .filter((entry) => entry.class === 'rotating-remote')
    .map((entry) => [entry.id.replace('fun-world-', ''), `${r2Manifest.base}/${entry.objectKey}`]),
);
const funHeroStrip = [
  await getR2ImageSources(funHeroFrame01, 256, 256),
  await getR2ImageSources(funHeroFrame02, 256, 256),
  await getR2ImageSources(funHeroFrame03, 256, 256),
  await getR2ImageSources(funHeroFrame04, 256, 256),
  await getR2ImageSources(funHeroFrame05, 256, 256),
  await getR2ImageSources(funHeroFrame06, 256, 256),
  await getR2ImageSources(funHeroFrame07, 256, 256),
  await getR2ImageSources(funHeroFrame08, 256, 256),
  await getR2ImageSources(funHeroFrame09, 256, 256),
  await getR2ImageSources(funHeroFrame10, 256, 256),
  await getR2ImageSources(funHeroFrame11, 256, 256),
  await getR2ImageSources(funHeroFrame12, 256, 256),
  await getR2ImageSources(funHeroFrame13, 256, 256),
  await getR2ImageSources(funHeroFrame14, 256, 256),
  await getR2ImageSources(funHeroFrame15, 256, 256),
  await getR2ImageSources(funHeroFrame16, 256, 256),
  await getR2ImageSources(funHeroFrame17, 256, 256),
  await getR2ImageSources(funHeroFrame18, 256, 256),
  await getR2ImageSources(funHeroFrame19, 256, 256),
  await getR2ImageSources(funHeroFrame20, 256, 256),
  await getR2ImageSources(funHeroFrame21, 256, 256),
  await getR2ImageSources(funHeroFrame22, 256, 256),
];
---

<!doctype html>
<html lang={locale} data-site-base={siteBase}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageCopy.title}</title>
    <meta name="description" content={pageCopy.description} />
    <link rel="canonical" href={canonicalUrl} />
    <SeoAlternateLinks pathname="/" siteBase={siteBase} currentLocale={locale} />
    <meta name="baidu-site-verification" content="codeva-A9s3yT3z5m" />
    <meta name="og:title" content={pageCopy.title} />
    <meta name="og:description" content={pageCopy.description} />
    <meta name="og:type" content="website" />
    <GoogleAnalytics />
    <MicrosoftStoreBadgeScript />
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
      (function() {
        function isLunarNewYearPeriod() {
          const now = new Date();
          const year = now.getFullYear();
          const month = now.getMonth() + 1;
          const day = now.getDate();
          if (year === 2025) {
            if (month === 1 && day >= 29) return true;
            if (month === 2 && day <= 12) return true;
          }
          if (year === 2026) {
            if (month === 2 && day >= 17) return true;
            if (month === 3 && day <= 3) return true;
          }
          return false;
        }

        const stored = localStorage.getItem('starlight-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = stored || (isLunarNewYearPeriod() ? 'lunar-new-year' : system);
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="homepage">
    <LunarNewYearDecorations client:idle />
    <Navbar
      client:idle
      locale={locale}
      copy={interactiveCopy.navbar}
      themeToggleCopy={interactiveCopy.themeToggle}
      languageSwitcherCopy={interactiveCopy.languageSwitcher}
    />

    <main class="homepage" id="homepage-content" data-homepage-locale={locale}>
      <HeroSection
        client:idle
        locale={locale}
        copy={interactiveCopy.hero}
        workflowBoardCopy={interactiveCopy.workflowBoard}
        productOverviewVideo={{
          copy: pageCopy.productOverviewVideoCopy,
          featuredVideos: pageCopy.featuredHomepageVideos,
        }}
      />
      <CompareArena locale={locale} />
      <WorkflowStepsSection copy={workflowStepsCopy} />
      <FeaturesShowcase
        copy={featuresCopy}
        cliProfiles={cliProfiles}
        personaAvatars={personaAvatars}
        personaPool={r2PersonaPool}
        worldCovers={funWorldCovers}
        remoteWorldCovers={funRemoteWorldCovers}
        heroStrip={funHeroStrip}
        client:visible
      />
      <ShowcaseSection copy={showcaseCopy} images={showcaseImages} client:visible />
      <VideoShowcase
        eyebrow={pageCopy.supportingSection.eyebrow}
        title={pageCopy.supportingSection.title}
        description={pageCopy.supportingSection.description}
        supportingLabel={pageCopy.supportingSection.supportingLabel}
        supportingVideos={pageCopy.supportingHomepageVideos}
      />
      <PricingComparisonSection
        content={pricingContent}
      />
    </main>

    <PromotoBanner locale={locale} />
    <SiteFooter locale={locale} />
    <AnalyticsScripts />
  </body>
</html>
