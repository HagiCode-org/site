---
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import MicrosoftStoreBadgeScript from '@/components/MicrosoftStoreBadgeScript.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Navbar from '@/components/home/Navbar';
import PromotoBanner from '@hagicode/hagilight-core/PromotoBanner';
import SeoAlternateLinks from '@/components/SeoAlternateLinks.astro';
import DesktopHero from '@/components/desktop/DesktopHero';
import StructuredArticleBlocks from '@/components/structured-article/StructuredArticleBlocks.astro';
import StructuredArticleMetaRow from '@/components/structured-article/StructuredArticleMetaRow.astro';
import RelatedComparisons from '@/components/compare/RelatedComparisons.astro';
import { gaEventAttributes } from '@hagicode/hagilight-core/analytics-events';
import { getDocsAbsoluteUrl } from '@/lib/shared/links';
import type { StructuredArticleViewModel } from '@/components/structured-article/types';
import type { SiteLocale } from '@/i18n/locale-metadata';
import {
  getSerializedPageTranslationBootstrap,
  getServerTranslation,
} from '@/i18n/translation-resources';
import { getHomepageInteractiveCopy } from '@/lib/homepage-runtime-copy';
import { getAbsoluteSiteUrl } from '@/lib/locale-routing';
import { getStructuredArticleViewModel } from '@/lib/structured-articles.mjs';
import '@/styles/homepage.css';
import '@/styles/desktop.css';
import { agentAccent } from '@/components/compare/agent-accents';
import '@/components/compare/compare-page.css';
import '@/components/compare/compare-duel.css';

interface Props {
  slug: string;
  locale: SiteLocale;
}

const { slug, locale } = Astro.props;
const siteBase = import.meta.env.VITE_SITE_BASE || '';
const interactiveCopy = getHomepageInteractiveCopy(locale);
const viewModel: StructuredArticleViewModel = getStructuredArticleViewModel(slug, locale);
const canonicalUrl = getAbsoluteSiteUrl(`/${slug}/`, locale, siteBase);
const { t } = getServerTranslation(locale);
const desktopI18nBootstrap = getSerializedPageTranslationBootstrap(locale, ['common', 'desktop']);
const heroBadge = t('desktopHero.badge');
const heroTagline = t('desktopHero.tagline');
const installHref = getDocsAbsoluteUrl('/installation/desktop/', locale);
const SITE_ORIGIN = 'https://www.hagicode.com';

// The h1 keeps the article title word for word; when it reads "<agent> <vs> HagiCode<rest>" the
// three parts become the face-off lockup and `rest` drops to a quieter second line.
const titleMatch = (() => {
  const { title, agentName } = viewModel;
  const hagicodeAt = title.indexOf('HagiCode');
  if (!title.startsWith(agentName) || hagicodeAt <= agentName.length) {
    return null;
  }

  const versus = title.slice(agentName.length, hagicodeAt).trim();
  if (versus === '' || versus.length > 6) {
    return null;
  }

  return { versus, rest: title.slice(hagicodeAt + 'HagiCode'.length).replace(/^[\s:：\-—–]+/u, '') };
})();
const accentStyle = `--agent: ${agentAccent(viewModel.accentIndex)}`;

// Article + FAQPage structured data. The FAQ entries are the same text the page renders below,
// so the markup never describes content a reader cannot see.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: viewModel.title,
      description: viewModel.description,
      inLanguage: viewModel.resolvedLocale,
      dateModified: viewModel.updatedAt,
      mainEntityOfPage: canonicalUrl,
      author: { '@type': 'Organization', name: 'HagiCode', url: SITE_ORIGIN },
      publisher: { '@type': 'Organization', name: 'HagiCode', url: SITE_ORIGIN },
    },
    ...(viewModel.faq.length === 0
      ? []
      : [
          {
            '@type': 'FAQPage',
            '@id': `${canonicalUrl}#faq`,
            mainEntity: viewModel.faq.map((entry) => ({
              '@type': 'Question',
              name: entry.question,
              acceptedAnswer: { '@type': 'Answer', text: entry.answer },
            })),
          },
        ]),
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</gu, '\\u003c');
---

<!doctype html>
<html lang={locale} data-site-base={siteBase}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{viewModel.title}</title>
    <meta name="description" content={viewModel.description} />
    <link rel="canonical" href={canonicalUrl} />
    <SeoAlternateLinks pathname={`/${slug}/`} siteBase={siteBase} currentLocale={locale} />
    <meta name="baidu-site-verification" content="codeva-A9s3yT3z5m" />
    <meta name="og:title" content={viewModel.title} />
    <meta name="og:description" content={viewModel.description} />
    <meta name="og:type" content="website" />
    <meta name="og:url" content={canonicalUrl} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    <GoogleAnalytics />
    <MicrosoftStoreBadgeScript />
    <script is:inline set:html={desktopI18nBootstrap} />
    <script is:inline>
      (function() {
        function isLunarNewYearPeriod() {
          const now = new Date();
          const year = now.getFullYear();
          const month = now.getMonth() + 1;
          const day = now.getDate();
          if (year === 2025) {
            if (month === 1 && day >= 29) return true;
            if (month === 2 && day <= 12) return true;
          }
          if (year === 2026) {
            if (month === 2 && day >= 17) return true;
            if (month === 3 && day <= 3) return true;
          }
          return false;
        }

        const stored = localStorage.getItem('starlight-theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = stored || (isLunarNewYearPeriod() ? 'lunar-new-year' : system);
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="homepage">
    <Navbar
      client:idle
      locale={locale}
      copy={interactiveCopy.navbar}
      themeToggleCopy={interactiveCopy.themeToggle}
      languageSwitcherCopy={interactiveCopy.languageSwitcher}
    />
    <main class="compare-page" style={accentStyle}>
      <section class="compare-page__hero">
        {titleMatch === null ? (
          <h1 class="compare-page__title">{viewModel.title}</h1>
        ) : (
          <h1 class="compare-page__title compare-page__title--duel">
            <span class="compare-page__duel">
              <span class="compare-page__fighter compare-page__fighter--agent">{viewModel.agentName}</span>{' '}
              <span class="compare-page__vs"><span>{titleMatch.versus}</span></span>{' '}
              <span class="compare-page__fighter compare-page__fighter--hagi">HagiCode</span>
            </span>
            {titleMatch.rest === '' ? null : (
              <>
                <span class="duel__sr">: </span>
                <span class="compare-page__title-rest">{titleMatch.rest}</span>
              </>
            )}
          </h1>
        )}
        <p class="compare-page__subtitle">{viewModel.summary}</p>
        <p class="compare-page__hero-cta">
          <a
            class="structured-cta-button variant-primary"
            href={installHref}
            {...gaEventAttributes({ category: 'navigation', label: 'installDesktop', location: 'compare_cta' })}
          >
            {t('compare.ctaButton')}
          </a>
        </p>
      </section>

      <div class="compare-page__layout">
        <nav class="compare-rail" aria-label={t('compare.tocLabel')}>
          <p class="compare-rail__label" aria-hidden="true">{t('compare.tocLabel')}</p>
          <ol class="compare-rail__list">
            {viewModel.toc.map((entry) => (
              <li><a class="compare-rail__link" href={`#${entry.id}`} data-rail-link>{entry.title}</a></li>
            ))}
            {viewModel.faq.length > 0 && (
              <li><a class="compare-rail__link" href="#faq" data-rail-link>{t('compare.faqTitle')}</a></li>
            )}
          </ol>
        </nav>

      <div class="compare-page__body">
        <StructuredArticleMetaRow
          requestedLocale={viewModel.requestedLocale}
          resolvedLocale={viewModel.resolvedLocale}
          usedFallback={viewModel.usedFallback}
          updatedAt={viewModel.updatedAt}
        />

        {viewModel.sections.map((section) => (
          <section id={section.id} class="compare-section structured-section">
            <h2 class="compare-section__title">{section.title}</h2>
            <StructuredArticleBlocks
              blocks={section.blocks}
              agentName={viewModel.agentName}
              verdictAgentLabel={t('compare.choosePaneAgent')}
              verdictHagicodeLabel={t('compare.choosePaneHagicode')}
            />
          </section>
        ))}

        {viewModel.faq.length > 0 && (
          <section id="faq" class="compare-section structured-section">
            <h2 class="compare-section__title">{t('compare.faqTitle')}</h2>
            <div class="structured-faq">
              {viewModel.faq.map((entry) => (
                <article class="structured-faq__item">
                  <h3 class="structured-faq__question">{entry.question}</h3>
                  <p class="structured-faq__answer">{entry.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <RelatedComparisons
          locale={locale}
          currentSlug={slug}
          heading={t('compare.moreTitle')}
          withCta
        />

        <section class="hero structured-desktop-hero">
          <div class="hero-content">
            <div class="hero-badge">{heroBadge}</div>
            <p class="hero-tagline">{heroTagline}</p>
            <DesktopHero client:load locale={locale} />
          </div>
        </section>
      </div>
      </div>
    </main>
    <PromotoBanner locale={locale} />
    <SiteFooter locale={locale} />
    <script>
      // Pointer light on cards and rows (mouse only), and the "on this page" rail follows the scroll.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;

      document.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse' || reduceMotion.matches) {
          return;
        }

        const target = (event.target as Element | null)?.closest<HTMLElement>('[data-spotlight]');
        if (!target) {
          return;
        }

        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const box = target.getBoundingClientRect();
          target.style.setProperty('--sx', `${event.clientX - box.left}px`);
          target.style.setProperty('--sy', `${event.clientY - box.top}px`);
        });
      });

      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
      const sections = links
        .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
        .filter((section): section is HTMLElement => section !== null);

      if (links.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (!visible) {
              return;
            }

            links.forEach((link) => {
              if (link.getAttribute('href') === `#${visible.target.id}`) {
                link.setAttribute('aria-current', 'location');
              } else {
                link.removeAttribute('aria-current');
              }
            });
          },
          { rootMargin: '-15% 0px -70% 0px' },
        );

        sections.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>